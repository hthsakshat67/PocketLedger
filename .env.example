AUTH_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-second-long-random-secret
AUTH_EMAIL_FROM=PocketLedger <no-reply@example.com>

